{
  "manifest_version": 3,
  "name": "Pomodoro Cult",
  "description": "Minimal focus timer with tasks, statistics, and MV3 offscreen timing.",
  "version": "1.0.0",
  "action": {
    "default_title": "Pomodoro Cult",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "permissions": [
    "storage",
    "offscreen"
  ],
  "minimum_chrome_version": "109"
}
